# Tokens the block and inline scanners branch on. Without these the fuzzer
# spends its budget rediscovering that "```" means something.
fence="```"
tilde_fence="~~~"
heading="### "
setext="==="
rule="---"
quote="> "
bullet="- "
ordered="1. "
task="- [x] "
link="[a](b)"
image="![a](b)"
reflink="[a][b]"
refdef="[a]: b"
emphasis="*"
strong="**"
strike="~~"
code="`"
entity="&amp;"
numeric_entity="&#65;"
autolink="<http://a>"
html_open="<div>"
html_close="</div>"
comment="<!-- -->"
table_row="| a | b |"
table_align="| --- | ---: |"
footnote="[^1]"
backslash="\\"
hard_break="  \x0a"
